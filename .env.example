PORT=3000

# -------------------------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------------------------
# Standard connection string format:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bulk_email_agent
DATABASE_SSL=false

# Optional PostgreSQL credentials for docker-compose:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bulk_email_agent
POSTGRES_PORT=5432

# Active Provider: 'gmail', 'ses', 'smtp', or 'mock'
# (You can also toggle between them anytime in the web dashboard header)
EMAIL_PROVIDER=gmail

# Common Sender Info
EMAIL_FROM=your_verified_email@example.com
EMAIL_FROM_NAME=Bulk Email Agent

# -------------------------------------------------------------
# 1. GMAIL / SMTP SETTINGS
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_app_password

# -------------------------------------------------------------
# 2. AMAZON SES (SIMPLE EMAIL SERVICE) SETTINGS
# -------------------------------------------------------------
# Option A: AWS IAM Access Keys (Direct SES API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Option B: SES SMTP Credentials (alternative to IAM API keys)
SES_SMTP_USER=
SES_SMTP_PASS=
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=465
SES_REGION=us-east-1

# -------------------------------------------------------------
# Rate Limits & Worker Intervals
# -------------------------------------------------------------
# Gmail: ~30-60/min. SES production: 14-50+/sec (configure per your AWS SES quota)
MAX_EMAILS_PER_MINUTE=30
BATCH_SIZE=10
WORKER_INTERVAL_MS=2000

# When in mock mode, simulates delivery status
MOCK_SIMULATE_DELIVERY=true
